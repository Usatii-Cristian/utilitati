{
  "name": "link-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Hub personal de linkuri - dashboard static PWA cu tool-uri, repo-uri si site-uri utile",
  "author": "Usatii Cristian-Ovidiu",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && node scripts/run-desktop.mjs",
    "desktop:run": "node scripts/run-desktop.mjs",
    "desktop:build": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "io.linkhub.desktop",
    "productName": "LINK//HUB",
    "directories": { "output": "dist-desktop" },
    "files": ["desktop/**/*", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": "out", "to": "out" },
      { "from": "data/local-targets.json", "to": "local-targets.json" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LINK//HUB"
    }
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
